---
import type { Resume } from '@/content/config';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import GitHub from '@/icons/GitHub.astro';

const { data } = Astro.props;
const { projects } = data as Resume;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul>
  {
    projects.map(({ url, description, highlights, name, isActive, github }) => (
      <li>
        <article>
          <header>
            <div class='project-heading'>
              <h3>
                {url ? (
                  <a
                    href={url}
                    title={`${t('projects.link')} ${name}`}
                    target='_blank'
                    rel='noopener noreferrer'>
                    {name}
                  </a>
                ) : (
                  name
                )}
                {isActive && <span>&bull;</span>}
              </h3>
              {(url || github) && (
                <nav
                  class='project-links'
                  aria-label={`${t('projects.links')} ${name}`}>
                  {url && (
                    <a
                      href={url}
                      target='_blank'
                      rel='noopener noreferrer'
                      title={`${t('projects.link')} ${name}`}>
                      {t('projects.website')}{' '}
                      <span aria-hidden='true'>↗</span>
                    </a>
                  )}
                  {github && (
                    <a
                      href={github}
                      target='_blank'
                      rel='noopener noreferrer'
                      title={`${t('projects.sourceCode')} ${name}${t('projects.sourceCodeFollowing')}`}>
                      <span aria-hidden='true'><GitHub /></span>{' '}
                      {t('projects.source')}
                    </a>
                  )}
                </nav>
              )}
            </div>
            <p>{description}</p>
          </header>
          <footer>
            {highlights.map((highlight) => (
              <span>{highlight}</span>
            ))}
          </footer>
        </article>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  li + li {
    border-top: 1px solid var(--projects-background);
    margin-top: 24px;
    padding-top: 24px;
  }

  article {
    gap: 16px;
    display: flex;
    flex-direction: column;
  }

  .project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 8px;
  }

  article h3 {
    color: var(--black-text);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 600;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  article h3 span {
    color: var(--projects-active);
    margin-left: 2px;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  article p {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  article a {
    color: var(--black-text);
  }

  article a:hover {
    text-decoration: underline;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .project-links,
  footer {
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .project-links span {
    color: var(--soft-primary-text);
    display: inline-flex;
  }

  footer {
    color: var(--primary-text);
    font-family: var(--font-mono);
    letter-spacing: normal;
  }

  footer span + span::before {
    content: '•';
    color: var(--soft-primary-text);
    margin: 0 0.35em;
  }

  @media screen {
    li + li {
      margin-top: 32px;
      padding-top: 32px;
    }

    article h3 {
      font-size: 1.25rem;
      line-height: 1.6;
    }

    article p {
      font-size: 1rem;
      line-height: 1.75;
    }

    .project-links,
    footer {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
  }

  @media print {
    li {
      break-inside: avoid;
    }

    article h3 span {
      animation: none;
    }
  }
</style>
